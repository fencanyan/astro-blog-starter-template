---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		
		<!-- 首屏背景区 -->
		<div class="hero-wrapper">
			<div class="hero-content">
				<h1>臻承烟酒行</h1>
				<p class="subtitle">专注品质 · 传承经典</p>
				<div class="divider"></div>
				<p class="description">
					我们致力于为您提供保真、优质的白酒、红酒、洋酒及精选香烟。<br>
					无论是日常品鉴、商务宴请还是佳节送礼，这里都能满足您的需求。
				</p>
			</div>
		</div>

		<main>
			<!-- 瀑布流展示区 -->
			<section class="masonry-section">
				<div class="section-header">
					<h2>精选推荐</h2>
					<p>甄选好物 · 品质保障</p>
				</div>
				
				<!-- 瀑布流容器 -->
				<div class="masonry-grid">
					<!-- 卡片 1 -->
					<div class="masonry-item">
						<div class="card-img" style="background-color: #f0e6d2;">🍶</div>
						<div class="card-body">
							<h3>高端酱香白酒</h3>
							<p>贵州茅台、五粮液等一线名酒，年份原浆，酱香浓郁，空杯留香，是商务宴请与收藏的绝佳之选。</p>
						</div>
					</div>
					<!-- 卡片 2 -->
					<div class="masonry-item">
						<div class="card-img" style="background-color: #e8dada;">🚬</div>
						<div class="card-body">
							<h3>正品烟草专区</h3>
							<p>各大知名品牌香烟，保证正品，支持现场验货。品类齐全，满足您的日常需求。</p>
						</div>
					</div>
					<!-- 卡片 3 -->
					<div class="masonry-item">
						<div class="card-img" style="background-color: #dcd2d2;">🍷</div>
						<div class="card-body">
							<h3>原瓶进口红酒</h3>
							<p>法国波尔多、智利、澳洲等知名产区原瓶进口。果香馥郁，单宁柔顺，为您带来纯正的异国风情。无论是浪漫晚餐还是独自小酌，都能完美胜任。</p>
						</div>
					</div>
					<!-- 卡片 4 -->
					<div class="masonry-item">
						<div class="card-img" style="background-color: #e2d8c3;">🥃</div>
						<div class="card-body">
							<h3>知名品牌洋酒</h3>
							<p>苏格兰威士忌、法国干邑白兰地，口感醇厚，层次丰富，彰显非凡品味。</p>
						</div>
					</div>
					<!-- 卡片 5 -->
					<div class="masonry-item">
						<div class="card-img" style="background-color: #eedede;">🎁</div>
						<div class="card-body">
							<h3>节日礼盒定制</h3>
							<p>逢年过节，走亲访友，我们为您提供贴心、体面的礼品搭配方案。企业团购采购可享专属优惠。</p>
						</div>
					</div>
				</div>
			</section>

			<!-- 联系我们 -->
			<section class="contact">
				<div class="section-header">
					<h2>联系我们</h2>
					<p>欢迎莅临品鉴</p>
				</div>
				
				<div class="contact-box">
					<div class="contact-item">
						<span class="label">📍 门店地址</span>
						<span class="value">盘锦市双台子区建设街繁荣小区</span>
					</div>
					<div class="contact-item">
						<span class="label">📞 联系电话</span>
						<span class="value"><a href="tel:13082225444">130 8222 5444</a></span>
					</div>
					<div class="contact-item">
						<span class="label">🕒 营业时间</span>
						<span class="value">09:00 - 22:00 (全年无休)</span>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* 定义全局颜色变量 */
	:global(:root) {
		--brand-red: #8b0000;
		--brand-gold: #c5a059;
		--bg-color: #f7f6f2;
		--text-dark: #333333;
		--text-gray: #666666;
	}

	body {
		background-color: var(--bg-color);
		background-image: radial-gradient(#e6e3db 1px, transparent 1px);
		background-size: 20px 20px;
		margin: 0;
		padding: 0;
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
	}

	/* 首屏背景 */
	.hero-wrapper {
		background: linear-gradient(135deg, #1a0505 0%, #3b0a0a 100%);
		padding: 6rem 1rem;
		text-align: center;
		color: #fff;
		position: relative;
		overflow: hidden;
	}
	.hero-wrapper::after {
		content: '';
		position: absolute;
		top: 0; left: 0; right: 0; bottom: 0;
		background: url('https://www.transparenttextures.com/patterns/stardust.png') repeat;
		opacity: 0.1;
		pointer-events: none;
	}
	.hero-content {
		position: relative;
		z-index: 1;
		max-width: 800px;
		margin: 0 auto;
	}
	.hero-content h1 {
		font-size: 3.5rem;
		color: var(--brand-gold);
		margin-bottom: 1rem;
		letter-spacing: 6px;
		text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
	}
	.hero-content .subtitle {
		font-size: 1.3rem;
		color: #ddd;
		letter-spacing: 4px;
		margin-bottom: 2rem;
	}
	.hero-content .divider {
		width: 60px;
		height: 2px;
		background: var(--brand-gold);
		margin: 0 auto 2rem auto;
	}
	.hero-content .description {
		font-size: 1.1rem;
		color: #ccc;
		line-height: 2;
	}

	/* 主体内容 */
	main {
		max-width: 1200px;
		margin: -3rem auto 0;
		padding: 0 1rem 4rem;
		position: relative;
		z-index: 2;
	}

	/* 区块标题 */
	.section-header {
		text-align: center;
		margin-bottom: 3rem;
	}
	.section-header h2 {
		font-size: 2.2rem;
		color: var(--brand-red);
		margin-bottom: 0.5rem;
		letter-spacing: 2px;
	}
	.section-header p {
		color: var(--brand-gold);
		font-size: 0.9rem;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	/* ==================== 瀑布流核心 CSS ==================== */
	.masonry-section {
		margin-bottom: 5rem;
	}
	.masonry-grid {
		column-count: 3; /* 默认分为 3 列 */
		column-gap: 2rem; /* 列与列之间的间距 */
	}
	.masonry-item {
		break-inside: avoid; /* 防止卡片被截断分到两列 */
		margin-bottom: 2rem; /* 卡片上下间距 */
		background: #fff;
		border-radius: 12px;
		overflow: hidden;
		box-shadow: 0 10px 30px rgba(0,0,0,0.05);
		transition: all 0.4s ease;
		border-top: 4px solid var(--brand-red);
	}
	.masonry-item:hover {
		transform: translateY(-8px);
		box-shadow: 0 15px 40px rgba(139, 0, 0, 0.15);
	}
	.card-img {
		height: 180px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 4rem;
		/* 如果有真实图片，这里可以换成 img 标签和 object-fit: cover */
	}
	.card-body {
		padding: 2rem;
	}
	.card-body h3 {
		font-size: 1.4rem;
		color: var(--text-dark);
		margin-top: 0;
		margin-bottom: 1rem;
	}
	.card-body p {
		color: var(--text-gray);
		line-height: 1.8;
		font-size: 0.95rem;
		margin: 0;
	}

	/* 联系卡片 */
	.contact-box {
		background: #fff;
		max-width: 900px;
		margin: 0 auto;
		padding: 3rem;
		border-radius: 12px;
		box-shadow: 0 10px 30px rgba(0,0,0,0.05);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
	}
	.contact-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.contact-item .label {
		font-size: 0.9rem;
		color: var(--brand-gold);
		margin-bottom: 0.5rem;
		font-weight: bold;
		letter-spacing: 1px;
	}
	.contact-item .value {
		font-size: 1.1rem;
		color: var(--text-dark);
		font-weight: 500;
	}
	.contact-item .value a {
		color: var(--brand-red);
		text-decoration: none;
		font-weight: bold;
		font-size: 1.3rem;
	}

	/* 响应式适配 */
	@media (max-width: 992px) {
		.masonry-grid {
			column-count: 2; /* 平板尺寸变 2 列 */
		}
	}
	@media (max-width: 768px) {
		.hero-wrapper {
			padding: 4rem 1rem;
		}
		.hero-content h1 {
			font-size: 2.5rem;
			letter-spacing: 3px;
		}
		.hero-content .description br {
			display: none;
		}
		main {
			margin-top: -2rem;
		}
		.masonry-grid {
			column-count: 1; /* 手机尺寸变 1 列 */
		}
		.contact-box {
			padding: 2rem 1rem;
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}
</style>
