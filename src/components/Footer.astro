---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p class="copyright">
			&copy; {today.getFullYear()} 臻承烟酒行. 保留所有权利。
		</p>
		<!-- 如果需要备案号，可以取消下面这行的注释并填入你的备案号 -->
		<!-- <p class="icp"><a href="https://beian.miit.gov.cn/" target="_blank">XICP备XXXXXXXX号</a></p> -->
	</div>
</footer>

<style>
	footer {
		margin-top: 4rem;
		padding: 3rem 1rem;
		background: #fcfcfc; /* 极浅的灰色背景 */
		border-top: 1px solid #eee; /* 顶部细线分隔 */
		text-align: center;
		color: #666;
		font-size: 0.9rem;
	}

	.footer-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.copyright {
		margin: 0;
		letter-spacing: 1px;
	}

	/* 备案号样式（如果使用的话） */
	.icp a {
		color: #999;
		text-decoration: none;
		font-size: 0.8rem;
	}

	.icp a:hover {
		color: #8b0000;
	}
</style>
