---
// 移除了不再需要的 HeaderLink 和 SITE_TITLE 引入
---

<header>
	<nav>
		<h2><a href="/">臻承烟酒行</a></h2>
		
		<!-- 右侧可以放个简单的联系方式或营业时间，如果你不需要，把下面这个 div 删掉即可 -->
		<div class="contact-info">
			📞 138-xxxx-xxxx
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 2em; /* 稍微增加左右内边距，显得更大气 */
		background: white;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); /* 修复了原代码可能因变量未定义导致的阴影失效 */
	}
	
	h2 {
		margin: 0;
		font-size: 1.5em; /* 字体稍微放大，作为店名更醒目 */
		letter-spacing: 2px; /* 增加字间距，更有商务感 */
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #8b0000; /* 经典暗红色，符合烟酒行气质 */
	}
	
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		height: 70px; /* 固定头部高度 */
	}
	
	nav a {
		text-decoration: none;
	}
	
	/* 右侧联系方式的样式 */
	.contact-info {
		font-size: 1rem;
		color: #333;
		font-weight: bold;
		background: #f9f9f9;
		padding: 8px 16px;
		border-radius: 20px;
	}

	/* 移动端适配 */
	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}
		h2 {
			font-size: 1.2em;
		}
		.contact-info {
			font-size: 0.9em;
			padding: 6px 12px;
		}
	}
</style>
